@model List<OrderListModel>
@{
    ViewData["Title"] = "Siparişlerim";
    Layout = "_Layout";
}

<div class="container py-5">
    <h2 class="text-center mb-5">Siparişlerim</h2>

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info text-center">
            <i class="bi bi-info-circle me-2"></i>Henüz hiç siparişiniz bulunmamaktadır.
        </div>
    }
    else
    {
        <div class="row">
            @foreach (var order in Model)
            {
                <div class="col-md-6 mb-4">
                    <a href="/Cart/OrderDetails/@order.OrderId" class="text-decoration-none text-dark">
                        <div class="card border-0 shadow-sm h-100">
                            <div class="card-header bg-white">
                                <div class="d-flex justify-content-between align-items-center">
                                    <h5 class="mb-0">Sipariş #@order.OrderNumber</h5>
                                    <span class="badge @(order.OrderStatus == EnumOrderStatus.completed ? "bg-success" : 
                                                      order.OrderStatus == EnumOrderStatus.pending ? "bg-warning" : "bg-danger")">
                                        @order.OrderStatus
                                    </span>
                                </div>
                                <small class="text-muted">@order.OrderDate.ToString("dd.MM.yyyy HH:mm")</small>
                            </div>
                            <div class="card-body">
                                <div class="mb-3">
                                    <h6 class="fw-bold">Teslimat Bilgileri</h6>
                                    <p class="mb-1">@order.FirstName @order.LastName</p>
                                    <p class="mb-1">@order.Adress</p>
                                    <p class="mb-1">@order.City</p>
                                    <p class="mb-1">@order.Phone</p>
                                    <p class="mb-0">@order.Email</p>
                                </div>

                                <div class="mb-3">
                                    <h6 class="fw-bold">Sipariş Detayları</h6>
                                    <div class="table-responsive">
                                        <table class="table table-sm">
                                            <thead>
                                                <tr>
                                                    <th>Ürün</th>
                                                    <th>Adet</th>
                                                    <th>Fiyat</th>
                                                    <th>Toplam</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var item in order.OrderItems)
                                                {
                                                    <tr>
                                                        <td>
                                                            <div class="d-flex align-items-center">
                                                                <img src="~/img/@item.ImageUrl" class="img-thumbnail me-2" style="width: 50px; height: 50px; object-fit: cover;">
                                                                <span>@item.Name</span>
                                                            </div>
                                                        </td>
                                                        <td>@item.Quantity</td>
                                                        <td>@item.Price.ToString("C")</td>
                                                        <td>@((item.Price * item.Quantity).ToString("C"))</td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>

                                <div class="d-flex justify-content-between align-items-center border-top pt-3">
                                    <h6 class="mb-0">Toplam Tutar:</h6>
                                    <h5 class="mb-0 text-primary">@order.TotalPrice().ToString("C")</h5>
                                </div>
                            </div>
                        </div>
                    </a>
                </div>
            }
        </div>
    }
</div>

<style>
    .card {
        transition: transform 0.3s ease;
    }

    .card:hover {
        transform: translateY(-5px);
    }

    .badge {
        font-size: 0.8rem;
        padding: 0.5em 0.8em;
    }

    a:hover {
        text-decoration: none;
    }
</style>