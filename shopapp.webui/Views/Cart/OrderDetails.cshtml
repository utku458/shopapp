@model OrderListModel
@{
    ViewData["Title"] = "Sipariş Detayı";
    Layout = "_Layout";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-10">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white">
                    <div class="d-flex justify-content-between align-items-center">
                        <h4 class="mb-0">Sipariş #@Model.OrderNumber</h4>
                        <span class="badge @(Model.OrderStatus == EnumOrderStatus.completed ? "bg-success" : 
                                          Model.OrderStatus == EnumOrderStatus.pending ? "bg-warning" : "bg-danger")">
                            @Model.OrderStatus
                        </span>
                    </div>
                    <small class="text-muted">Sipariş Tarihi: @Model.OrderDate.ToString("dd.MM.yyyy HH:mm")</small>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-4">
                                <h5 class="fw-bold mb-3">Teslimat Bilgileri</h5>
                                <div class="card bg-light">
                                    <div class="card-body">
                                        <p class="mb-1"><strong>Ad Soyad:</strong> @Model.FirstName @Model.LastName</p>
                                        <p class="mb-1"><strong>Adres:</strong> @Model.Adress</p>
                                        <p class="mb-1"><strong>Şehir:</strong> @Model.City</p>
                                        <p class="mb-1"><strong>Telefon:</strong> @Model.Phone</p>
                                        <p class="mb-0"><strong>E-posta:</strong> @Model.Email</p>
                                    </div>
                                </div>
                            </div>

                            <div class="mb-4">
                                <h5 class="fw-bold mb-3">Kargo Durumu</h5>
                                <div class="card bg-light">
                                    <div class="card-body">
                                        <div class="timeline">
                                            <div class="timeline-item @(Model.OrderStatus == EnumOrderStatus.completed ? "active" : "")">
                                                <div class="timeline-marker"></div>
                                                <div class="timeline-content">
                                                    <h6 class="mb-1">Sipariş Alındı</h6>
                                                    <small class="text-muted">@Model.OrderDate.ToString("dd.MM.yyyy HH:mm")</small>
                                                </div>
                                            </div>
                                            <div class="timeline-item @(Model.OrderStatus == EnumOrderStatus.completed ? "active" : "")">
                                                <div class="timeline-marker"></div>
                                                <div class="timeline-content">
                                                    <h6 class="mb-1">Hazırlanıyor</h6>
                                                    <small class="text-muted">@Model.OrderDate.AddHours(1).ToString("dd.MM.yyyy HH:mm")</small>
                                                </div>
                                            </div>
                                            <div class="timeline-item @(Model.OrderStatus == EnumOrderStatus.completed ? "active" : "")">
                                                <div class="timeline-marker"></div>
                                                <div class="timeline-content">
                                                    <h6 class="mb-1">Kargoya Verildi</h6>
                                                    <small class="text-muted">@Model.OrderDate.AddDays(1).ToString("dd.MM.yyyy HH:mm")</small>
                                                </div>
                                            </div>
                                            <div class="timeline-item @(Model.OrderStatus == EnumOrderStatus.completed ? "active" : "")">
                                                <div class="timeline-marker"></div>
                                                <div class="timeline-content">
                                                    <h6 class="mb-1">Teslim Edildi</h6>
                                                    <small class="text-muted">@Model.OrderDate.AddDays(2).ToString("dd.MM.yyyy HH:mm")</small>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="mb-4">
                                <h5 class="fw-bold mb-3">Sipariş Detayları</h5>
                                <div class="table-responsive">
                                    <table class="table">
                                        <thead>
                                            <tr>
                                                <th>Ürün</th>
                                                <th>Adet</th>
                                                <th>Fiyat</th>
                                                <th>Toplam</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var item in Model.OrderItems)
                                            {
                                                <tr>
                                                    <td>
                                                        <div class="d-flex align-items-center">
                                                            <img src="~/img/@item.ImageUrl" class="img-thumbnail me-2" style="width: 50px; height: 50px; object-fit: cover;">
                                                            <span>@item.Name</span>
                                                        </div>
                                                    </td>
                                                    <td>@item.Quantity</td>
                                                    <td>@item.Price.ToString("C")</td>
                                                    <td>@((item.Price * item.Quantity).ToString("C"))</td>
                                                </tr>
                                            }
                                        </tbody>
                                        <tfoot>
                                            <tr>
                                                <td colspan="3" class="text-end"><strong>Toplam Tutar:</strong></td>
                                                <td><strong>@Model.TotalPrice().ToString("C")</strong></td>
                                            </tr>
                                        </tfoot>
                                    </table>
                                </div>
                            </div>

                            @if (!string.IsNullOrEmpty(Model.Note))
                            {
                                <div class="mb-4">
                                    <h5 class="fw-bold mb-3">Sipariş Notu</h5>
                                    <div class="card bg-light">
                                        <div class="card-body">
                                            <p class="mb-0">@Model.Note</p>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
                <div class="card-footer bg-white">
                    <a asp-controller="Cart" asp-action="Orders" class="btn btn-outline-primary">
                        <i class="bi bi-arrow-left me-2"></i>Siparişlerime Dön
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .timeline {
        position: relative;
        padding-left: 2rem;
    }

    .timeline-item {
        position: relative;
        padding-bottom: 1.5rem;
    }

    .timeline-item:last-child {
        padding-bottom: 0;
    }

    .timeline-marker {
        position: absolute;
        left: -1.5rem;
        width: 1rem;
        height: 1rem;
        border-radius: 50%;
        background-color: #dee2e6;
        border: 2px solid #fff;
    }

    .timeline-item.active .timeline-marker {
        background-color: #0d6efd;
    }

    .timeline-content {
        padding-left: 1rem;
    }

    .timeline-item:not(:last-child)::after {
        content: '';
        position: absolute;
        left: -1rem;
        top: 1rem;
        bottom: 0;
        width: 2px;
        background-color: #dee2e6;
    }

    .timeline-item.active:not(:last-child)::after {
        background-color: #0d6efd;
    }

    .card {
        transition: transform 0.3s ease;
    }

    .card:hover {
        transform: translateY(-5px);
    }
</style> 