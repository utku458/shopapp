@{
    ViewData["Title"] = "Sipariş Başarılı";
    Layout = "_Layout";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card border-0 shadow-lg rounded-4">
                <div class="card-body p-5">
                    <div class="text-center mb-4">
                        <div class="success-icon mb-4">
                            <svg xmlns="http://www.w3.org/2000/svg" width="80" height="80" fill="#28a745" class="bi bi-check-circle-fill" viewBox="0 0 16 16">
                                <path d="M16 8A8 8 0 1 1 0 8a8 8 0 0 1 16 0zm-3.97-3.03a.75.75 0 0 0-1.08.022L7.477 9.417 5.384 7.323a.75.75 0 0 0-1.06 1.06L6.97 11.03a.75.75 0 0 0 1.079-.02l3.992-4.99a.75.75 0 0 0-.01-1.05z"/>
                            </svg>
                        </div>
                        <h2 class="fw-bold text-success mb-3">Siparişiniz Başarıyla Alındı!</h2>
                        <p class="text-muted">Siparişiniz için teşekkür ederiz. Siparişiniz en kısa sürede kargoya verilecektir.</p>
                    </div>

                    <div class="order-details bg-light p-4 rounded-3 mb-4">
                        <h5 class="fw-bold mb-3">Sipariş Detayları</h5>
                        <div class="row">
                            <div class="col-md-6">
                                <p class="mb-2"><strong>Sipariş Numarası:</strong></p>
                                <p class="text-primary fw-bold">@ViewBag.OrderId</p>
                            </div>
                            <div class="col-md-6">
                                <p class="mb-2"><strong>Sipariş Tarihi:</strong></p>
                                <p>@DateTime.Now.ToString("dd.MM.yyyy HH:mm")</p>
                            </div>
                        </div>
                    </div>

                    <div class="text-center mt-4">
                        <div class="d-grid gap-3 d-md-flex justify-content-md-center">
                            <a href="/" class="btn btn-primary btn-lg px-4 me-md-2">
                                <i class="bi bi-house-door me-2"></i>Ana Sayfaya Dön
                            </a>
                            <a href="/account/orders" class="btn btn-outline-primary btn-lg px-4">
                                <i class="bi bi-list-ul me-2"></i>Siparişlerimi Görüntüle
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .success-icon {
        animation: scaleIn 0.5s ease-out;
    }

    @@keyframes scaleIn {
        0% {
            transform: scale(0);
            opacity: 0;
        }
        100% {
            transform: scale(1);
            opacity: 1;
        }
    }

    .card {
        transition: transform 0.3s ease;
    }

    .card:hover {
        transform: translateY(-5px);
    }
</style> 