@model CategoryListViewModel

@{

 
    Layout = "_Layout";
}


<div class="row">
    
    <div class="col-md-12">
        <h1>Admin Products</h1>
        <hr>
        <a class="btn btn-primary btn-sm" href="/admin/categories/create">Add Category</a>
        <table class="table table-bordered">
            
            
            <thead>
            <tr>
                <th style="width: 30px">ID</th>
                <th style="width: 100px">Name</th>
                
                
            </tr>
            
    
            </thead>
            
            <tbody>
            @if (Model.Categories.Count > 0)
            {
                @foreach (var item in Model.Categories)
                {
                    <tr>
                        <td>@item.CategoryId</td>
                        <td>@item.Name</td>

                        <td>@item.Url</td>

                      
                        <td>
                            <a class="btn btn-primary btn-sm mr-2" href="/admin/categories/@item.CategoryId">Edit</a>

                            <form style="display: inline" action="/admin/deletecategory" method="POST">
                                <input type="hidden" name="CategoryId" value="@item.CategoryId">
                                <button type="submit" class="btn btn-danger btn-sm mr-2">Delete</button>
                            </form>
                        </td>
                    </tr>
                }
            }
            else
            {
                <div class="alert alert-warning">
                    <h3>No Category</h3>
                </div>
            }
           

            </tbody>
        </table>
    </div>
</div>