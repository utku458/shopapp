<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="~/modules/bootstrap/dist/css/bootstrap.min.css" crossorigin="anonymous">
    @RenderSection("Css",false)
  
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" />
    <title>ShopApp</title>
</head>
<style>
    html, body {
    height: 100%;
    margin: 0;
    display: flex;
    flex-direction: column;
}

.content {
    flex: 1; /* İçeriğin olduğu bölümü esneterek sayfayı doldurur */
}

footer {
    background-color: #333;
    color: white;
    text-align: center;
    padding: 10px;
}

</style>
<body>
    @await Html.PartialAsync("_navbar")


    <main class="mb-4 mt-5 content">
        <div class="container">


            @if (TempData["message"] != null)
            {
                <div class="row">
                    <div class="col-md-12">
                        <div class="alert alert-warning">
                            @TempData["message"]
                        </div>
                    </div>
                </div>
            }
          
                @RenderBody()

      

     
             </div>
</main>

<footer class="py-5 bg-dark text-white text-center">ShopApp|2025</footer>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/_framework/aspnetcore-browser-refresh.js"></script>
    <script src="https://code.jquery.com/jquery-3.4.1.min.js"></script>
    
    @RenderSection("JS",false)
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" integrity="sha512-Evv84Mr4kqVGRNSgIGL/F/aIDqQb7xQ2vcrdIwxfjThSH8CSR7PBEakCr51Ck+w+/U6swU2Im1vVX0SVk9ABhg==" crossorigin="anonymous" referrerpolicy="no-referrer" />
</body>
</html>