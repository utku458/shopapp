@using shopapp.entity

@model List<Category>
 <div class="list-group"> 

    
     <a href="/products"  class="list-group-item list-group-item-action">Tum Kategoriler</a>
  
     
             @foreach(var item in Model){

         <a 
             asp-controller="Shop" asp-action="List" asp-route-category="@item.Url"
             class="list-group-item p-3 list-group-item-action 
                    @(ViewBag.SelectedCategory == item.Url?"active":"")">@item.Name</a>  
             }
            
             </div>