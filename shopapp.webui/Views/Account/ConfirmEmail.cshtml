@{

    
    Layout = "_Layout";
}

<div class="container text-center mt-5">
    <div class="card shadow-lg p-4 rounded-4 border-0">
        <div class="card-body">
            <h1 class="display-5 text-success"><i class="bi bi-check-circle-fill"></i> Email Doğrulandı</h1>
            <p class="lead mt-3">Tebrikler! Email adresiniz başarıyla doğrulandı.</p>
            <p class="text-muted">Artık hesabınızı kullanmaya başlayabilirsiniz. Giriş yaparak alışverişe devam edebilirsiniz.</p>
            <a href="~/Account/Login" class="btn btn-success mt-3">
                <i class="bi bi-box-arrow-in-right"></i> Giriş Yap
            </a>
        </div>
    </div>
</div>

