@using shopapp.entity

@model Product


@{
     
        Layout = "_Layout";
}

<div class="row"/>
<div class="col-md-3">

  @await Component.InvokeAsync("Categories")
</div>
<div class="col-9">
  <div class="card mb-3">
    <div class="row no-gutters">
      <div class="col-md-3">
        <img src="~/img/@Model.ImageUrl" class="card-img" alt="">
      </div>
      <div class="col-md-9">
        <div class="card-body">
          <h5 class="card-title">@Model.Name</h5>
          <p class="card-text">@Model.Description</p>
        </div>
      </div>
    </div>
  </div>
</div>

