@using shopapp.entity;

@model ProductListViewModel

@{
    var products = Model.Products;
    Layout = "_Layout";
}

<style>
    .category-list {
        margin: 0;
        padding: 0;
    }
</style>

<div class="container-fluid p-0">
    <div class="row g-0">
        <!-- Sol Tarafa Sabitlenmiş Kategoriler -->
        <div class="col-md-2 d-flex flex-column vh-100 border-end p-3">
            <div class="category-list">
                @await Component.InvokeAsync("Categories")
            </div>
        </div>

        <!-- Ürün Listesi -->
        <div class="col-md-10">
            <div class="row row-cols-1 row-cols-md-3 g-4">
                @foreach (var product in products)
                {
                    <div class="col d-flex">
                        <div class="card flex-fill">
                            @await Html.PartialAsync("_products", product)
                        </div>
                    </div>
                }
            </div>

            <!-- Sayfalama (Pagination) -->
            <div class="row mt-4">
                <div class="col d-flex justify-content-center">
                    <nav aria-label="Page navigation example">
                        <ul class="pagination">
                            @for (int i = 0; i < Model.PageInfo.TotalPages(); i++)
                            {
                                <li class="page-item @(Model.PageInfo.CurrentPage==i+1 ? "active" : "")">
                                    <a class="page-link" href="/products@(string.IsNullOrEmpty(Model.PageInfo.CurrentCategory) ? "" : "/" + Model.PageInfo.CurrentCategory)?page=@(i+1)">@(i+1)</a>
                                </li>
                            }
                        </ul>
                    </nav>
                </div>
            </div>
        </div>
    </div>
</div>
