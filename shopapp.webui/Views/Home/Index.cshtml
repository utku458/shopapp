

@model ProductListViewModel


@{
    
    var products = Model.Products;
        Layout = "_Layout";
}

<header>
  <div class="jumbotron  m-0 p-4 jumbotron-fluid bg-light text-center  w-100">
    <div class="container-fluid">
      <h1 class="display-4">Firma Adı</h1>
      <p class="lead">This is a modified jumbotron that occupies the entire horizontal space of its parent.</p>
    </div>
  </div>
</header>
<style>

 
    
        

     .card-container {
            display: flex;
            justify-content: center;
            gap: 20px;
            flex-wrap: wrap;
            padding: 20px;
        }
        .campaign-card {
            width: 200px;
            text-align: center;
        }
        .campaign-card img {
            width: 100%;
            border-radius: 15px;
            transition: transform 0.3s ease-in-out;
        }
        .campaign-card img:hover {
            transform: scale(1.05);
        }
        .campaign-title {
            margin-top: 10px;
            font-weight: bold;
        }
</style>



<div class="row">
    <div class="col-3 d-flex flex-column">
        @await Component.InvokeAsync("Categories")
        <partial name="_search"/>
    </div>

    <div class="col-9 d-flex flex-wrap">
        @foreach(var product in Model.Products){
            @await Html.PartialAsync("_products", product);
        }
    </div>
</div>




<div class="container w-75 d-flex justify-content-center mt-5 p-5">
    <div id="carouselExampleIndicators" class="carousel slide w-100" data-bs-ride="carousel">
        <div class="carousel-indicators">
            <button type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide-to="0" class="active" aria-current="true" aria-label="Slide 1"></button>
            <button type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide-to="1" aria-label="Slide 2"></button>
            <button type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide-to="2" aria-label="Slide 3"></button>
        </div>
        <div class="carousel-inner text-center">
            <div class="carousel-item active">
                <img class="d-block w-100  mx-auto" src="~/img/arkaplan.jpeg" alt="First slide">
            </div>
            <div class="carousel-item">
                <img class="d-block w-100  mx-auto" src="~/img/arkaplan.jpeg" alt="Second slide">
            </div>
            <div class="carousel-item">
                <img class="d-block w-100  mx-auto" src="~/img/arkaplan.jpeg" alt="Third slide">
            </div>
        </div>
        <button class="carousel-control-prev" type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide="prev">
            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Previous</span>
        </button>
        <button class="carousel-control-next" type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide="next">
            <span class="carousel-control-next-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Next</span>
        </button>
    </div>
</div>





<div class="container">
    <div class="card-container">
        <div class="campaign-card">
            <img src="~/img/arkaplan.jpeg" alt="Kampanya 1">
            <p class="campaign-title">Mobil Uygulamamızı Keşfedin!</p>
        </div>
        <div class="campaign-card">
            <img src="~/img/arkaplan.jpeg" alt="Kampanya 2">
            <p class="campaign-title">Stokları Eritiyoruz</p>
        </div>
        <div class="campaign-card">
            <img src="~/img/arkaplan.jpeg" alt="Kampanya 3">
            <p class="campaign-title">YapıKredi</p>
        </div>
        <div class="campaign-card">
            <img src="~/img/arkaplan.jpeg" alt="Kampanya 4">
            <p class="campaign-title">İş Bankası</p>
        </div>
        <div class="campaign-card">
            <img src="~/img/arkaplan.jpeg" alt="Kampanya 5">
            <p class="campaign-title">Yenilenmiş Telefonlar</p>
        </div>
        <div class="campaign-card">
            <img src="~/img/arkaplan.jpeg" alt="Kampanya 6">
            <p class="campaign-title">Eskiyi Getir Yeniyi Götür!</p>
        </div>
    </div>
</div>

<h5 class="ms-4 campaign-title">Cok satanlar</h5>
<div class="d-flex">

  @foreach(var product in products){
      
            @await Html.PartialAsync("_products",product);
 

 

    }
    </div>
<!-- Bootstrap JS -->



